        "id": "bc19972d1f11d26d",
        "type": "http request",
        "z": "5e9be696e4a6f986",
        "name": "API OpenWeather",
        "method": "GET",
        "ret": "obj",
        "url": "https://api.openweathermap.org/data/2.5/weather?q=Sao%20Paulo&appid=08e841658c98f87d7fa35eea15f907a1&units=metric",
        "x": 340,
