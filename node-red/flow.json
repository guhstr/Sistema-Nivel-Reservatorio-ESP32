        "wires": [
            [
                "70c977deb36cdcb2",
                "555d5693f20eb81d"
            ]
        ]
    },
    {
        "id": "70c977deb36cdcb2",
        "type": "function",
        "z": "5e9be696e4a6f986",
        "name": "Extrair Dados Clima",
        "func": "var d = msg.payload;\nvar msgs = [\n  { payload: d.main.temp, topic: 'temp_ext' },\n  { payload: d.main.humidity, topic: 'umidade' },\n  { payload: d.weather[0].description + ' | Vento: ' + d.wind.speed + ' m/s', topic: 'descricao' },\n  { payload: d.main.feels_like, topic: 'sensacao' }\n];\nreturn [msgs[0], msgs[1], msgs[2], msgs[3]];",
        "outputs": 4,
        "x": 570,
        "y": 460,
        "wires": [
            [
                "2f207f071b578090"
            ],
            [
                "6b1690c0ed50dece"
            ],
            [
                "8baf296772f91538"
            ],
            [
                "0f15f857e74948a6"
            ]
        ]
    },
    {
        "id": "555d5693f20eb81d",
        "type": "function",
        "z": "5e9be696e4a6f986",
        "name": "Salvar Clima SP",
        "func": "var d = msg.payload;\nvar temp  = d.main.temp;\nvar sens  = d.main.feels_like;\nvar umid  = d.main.humidity;\nvar desc  = d.weather[0].description.replace(/'/g, '');\nvar vento = d.wind.speed;\nmsg.topic = \"INSERT INTO clima_saopaulo (temperatura, sensacao, umidade, descricao, vento, criado_em) \" +\n            \"VALUES (\" + temp + \", \" + sens + \", \" + umid + \", '\" + desc + \"', \" + vento + \", NOW())\";\nreturn msg;",
        "outputs": 1,
        "x": 570,
        "y": 540,
        "wires": [
            [
                "aecfa38e43af6a9b"
            ]
        ]
    },
